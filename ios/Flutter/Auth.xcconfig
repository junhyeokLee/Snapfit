// Public Kakao native app key; matches Env.kakaoNativeAppKey and Android.
// Info.plist needs this Xcode setting to register the actual callback scheme.
KAKAO_NATIVE_APP_KEY = 34ecdf62d2b450c00c1d525d0cffa4df

// Existing public Google OAuth IDs for com.devsheep.snapFit. The iOS SDK reads
