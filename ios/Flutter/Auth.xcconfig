// Keep the server ID aligned with Env.googleWebClientId for Supabase ID tokens.
GOOGLE_IOS_CLIENT_ID = 991239566838-q3rs3vqvengj2975hoj8g1h87i369k4s.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.991239566838-q3rs3vqvengj2975hoj8g1h87i369k4s
GOOGLE_SERVER_CLIENT_ID = 991239566838-uvukou4dr1ucvkei1efgb38l09s6490g.apps.googleusercontent.com
