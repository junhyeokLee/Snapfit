# Placeholder names only. Create the real root-owned 0600 environment file
# outside the repository. Do not put credentials in command arguments/logs.
SNAPFIT_SUPABASE_URL=REPLACE_WITH_PROJECT_HTTPS_URL
SNAPFIT_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PROJECT_KEY
SNAPFIT_PRINT_WORKER_EMAIL=REPLACE_WITH_EXISTING_WORKER_ACCOUNT_EMAIL
SNAPFIT_PRINT_WORKER_PASSWORD=REPLACE_IN_PRIVATE_HOST_FILE_ONLY
