# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Local deployment cache and generated review output
/.firebase/
/output/
# Generated visual-test diagnostics; approved golden baselines remain tracked.
/test/**/failures/
# Local AI evaluation prompts, model responses and review artifacts
/output/ai-template-evaluations/
/output/template-preview/
/output/brand-studio/
# Physical-device captures may contain private photos and account details.
/output/device-journey-qa/
/tool/brand_studio/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Supabase local CLI cache (contains machine-local linked project metadata)
supabase/.temp/
supabase/.env.ai-template.local

# Template image sourcing candidates (review/transient; approved assets are copied elsewhere)
assets/templates/*/images/free_stock_candidates/
assets/templates/*/images/commons_candidates/
assets/templates/*/images/libreshot_candidates/
assets/templates/*/images/libreshot_candidates_extra/
assets/templates/*/images/pexels_candidates/
