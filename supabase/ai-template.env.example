# Server / local evaluator only. Never bundle an API key in Flutter or web assets.
# Copy to supabase/.env.ai-template.local (gitignored), or use Edge Function Secrets.
AI_TEMPLATE_PROVIDER=gemini
AI_TEMPLATE_MODEL=gemini-3.6-flash
AI_TEMPLATE_FREE_ONLY=true
GEMINI_API_KEY=
AI_TEMPLATE_MIN_CALL_INTERVAL_MS=1200
AI_TEMPLATE_TIMEOUT_MS=120000
AI_TEMPLATE_MAX_TRANSIENT_RETRIES=2
AI_TEMPLATE_RETRY_BASE_MS=1200
# Keep false: raw customer briefs are closed. The safeDesign customer route uses
# only finite enums and server-authored descriptions with its separate DB policy.
AI_TEMPLATE_ALLOW_UNPAID_USER_DATA=false
# Provision AI_TEMPLATE_WORKER_SECRET separately: random 64hex, matching the
# private Vault entry snapfit_ai_template_worker_secret. Never use a client key
# or reuse the print scheduler secret. Its Cron sends a single-use HMAC only.
# Worker requests enforce freeOnly=true, one model transport, zero internal
# retries, a 110s deadline and project-wide DB pacing of at least 65 seconds.
