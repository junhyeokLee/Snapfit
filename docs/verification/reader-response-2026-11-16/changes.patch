+    final moving =
+        (x > startX + .5 && x < endX - .5) ||
+        (controller != null &&
+            controller.isAnimating &&
+            controller.flipProgress > 0 &&
+            controller.flipProgress < 1);
+    moved |= moving;
+    if (moving) firstResponseFrame ??= frame + 1;
+  }
